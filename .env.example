# ---------------------------------------------------------------------------
# MLB Forecast V2 — copy to .env and load in your process manager, or set
# these in your host dashboard (Fly, Railway, Render, etc.).
# ---------------------------------------------------------------------------

# Default season for API when ?season= is omitted (optional)
# MLB_SEASON=2026

# If set, POST /api/admin/* requires header: X-Admin-Key: <same value>
# Use a long random string; match GitHub secret ADMIN_API_KEY for Actions.
# ADMIN_API_KEY=

# Browser origins allowed by CORS (comma-separated, no spaces)
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.example.com

# ---------------------------------------------------------------------------
# GitHub Actions (repo Settings → Secrets → Actions), or run:
#   ./scripts/set_github_actions_secrets.sh https://your-api.example.com
# ---------------------------------------------------------------------------
# API_BASE_URL   = https://your-api.example.com   (no trailing slash)
# ADMIN_API_KEY  = same as ADMIN_API_KEY on the API host

# ---------------------------------------------------------------------------
# Legacy Statcast stack (etl/, api/, web/) — see requirements-statcast.txt
# ---------------------------------------------------------------------------
# DB_URL=postgresql://user:password@localhost:5432/bluejays
# STATCAST_START=2023-01-01
# STATCAST_END=2023-12-31
