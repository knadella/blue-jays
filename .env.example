# ---------------------------------------------------------------------------
# Toronto Blue Jays Statcast — copy to .env and load in your process manager,
# or set these in your host dashboard (Fly, Railway, etc.).
# ---------------------------------------------------------------------------

# --- Local-only visualization work (disables github.io CORS; Statcast from disk only) ---
# MLB_LOCAL_SITE=1
# Parquet layout: data/statcast_local/{season}_{TEAM}.parquet
#   python scripts/download_statcast_extracts.py --seasons 2025 --abbrev TOR
# Savant-only lock (leave CORS defaults): STATCAST_REQUIRE_LOCAL=1

# Health check: use http://127.0.0.1:8000/api/health (not `localhost`) if curl appears to hang.

# Frontend default season pill (optional).
# VITE_MLB_SEASON=2026

# Default season for API when ?season= is omitted (optional)
# MLB_SEASON=2026

# If set, POST /api/admin/* requires header: X-Admin-Key: <same value>
# Use a long random string; match GitHub secret ADMIN_API_KEY for Actions.
# ADMIN_API_KEY=

# Browser origins allowed by CORS (comma-separated). Paths are stripped so
# https://user.github.io/repo matches the browser Origin https://user.github.io
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.example.com
#
# GitHub Pages user/org sites: the API also allows Origin https://<user>.github.io via a
# built-in regex (see ENABLE_GITHUB_PAGES_CORS). Custom Pages domains must still be listed here.

# Set to 0 to disable the automatic https://*.github.io CORS rule (default: enabled).
# ENABLE_GITHUB_PAGES_CORS=1

# ---------------------------------------------------------------------------
# GitHub Pages frontend build (Actions workflow deploy-github-pages.yml)
# ---------------------------------------------------------------------------
# VITE_API_URL — same as public API base, e.g. https://my-app.fly.dev (no trailing slash).

# ---------------------------------------------------------------------------
# GitHub Actions (repo Settings → Secrets → Actions)
# ---------------------------------------------------------------------------
# API_BASE_URL   = https://your-api.example.com   (no trailing slash)
# ADMIN_API_KEY  = same as ADMIN_API_KEY on the API host

# ---------------------------------------------------------------------------
# Weekly Statcast SPA — local Parquet extracts (optional; avoids live Savant pulls)
# ---------------------------------------------------------------------------
# Default directory: <repo>/data/statcast_local/{season}_{TEAM}.parquet
# Build: python scripts/download_statcast_extracts.py --seasons 2025 --all-teams
# STATCAST_LOCAL_DIR=/absolute/path/to/statcast_local
