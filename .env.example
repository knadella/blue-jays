# ---------------------------------------------------------------------------
# Blue Jays post-game tracker — copy to .env for local overrides.
# The site is fully static; there is no server and no secrets are required.
# ---------------------------------------------------------------------------

# Default season for scripts/build_site_data.py when --season is omitted.
# MLB_SEASON=2026

# Frontend default season pill (must match the season the data was built for).
# VITE_MLB_SEASON=2026

# Cache root for per-game WPA tallies etc. (default: .cache).
# APP_CACHE_DIR=.cache

# ---------------------------------------------------------------------------
# Statcast scripts (optional; local analysis only, not used by the site build)
# ---------------------------------------------------------------------------
# Parquet layout: data/statcast_local/{season}_{TEAM}.parquet
#   python scripts/download_statcast_extracts.py --seasons 2025 --abbrev TOR
# STATCAST_LOCAL_DIR=/absolute/path/to/statcast_local
# Fail instead of hitting Savant live: STATCAST_REQUIRE_LOCAL=1
# Same, plus skip all network I/O: MLB_LOCAL_SITE=1
