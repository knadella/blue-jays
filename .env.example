# ---------------------------------------------------------------------------
# MLB Forecast V2 — copy to .env and load in your process manager, or set
# these in your host dashboard (Fly, Railway, Render, etc.).
# ---------------------------------------------------------------------------

# --- Local-only visualization work (disables github.io CORS; Statcast from disk only) ---
# MLB_LOCAL_SITE=1
# Parquet layout: data/statcast_local/{season}_{TEAM}.parquet
#   python scripts/download_statcast_extracts.py --seasons 2025 --abbrev TOR
# Savant-only lock (leave CORS defaults): STATCAST_REQUIRE_LOCAL=1

# Health check: use http://127.0.0.1:8000/api/health (not `localhost`) if curl appears to hang — some systems try IPv6 ::1 first while uvicorn is only on 127.0.0.1.

# Frontend default season pill (optional). In `npm run dev`, the app defaults to 2025 when unset (matches common local Parquet).
# VITE_MLB_SEASON=2025

# Default season for API when ?season= is omitted (optional)
# MLB_SEASON=2026

# On Fly.io, defaults ON: first dashboard load uses a fast prior bootstrap if no snapshot exists.
# Set to false to always run MCMC on an empty cache (slow first HTTP response).
# INSTANT_DASHBOARD_PRIOR=false

# If set, POST /api/admin/* requires header: X-Admin-Key: <same value>
# Use a long random string; match GitHub secret ADMIN_API_KEY for Actions.
# ADMIN_API_KEY=

# Skip background dashboard warmup on API startup (local dev; not recommended on Fly)
# SKIP_DASHBOARD_WARMUP=1

# Browser origins allowed by CORS (comma-separated). Paths are stripped so
# https://user.github.io/repo matches the browser Origin https://user.github.io
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.example.com
#
# GitHub Pages user/org sites: the API also allows Origin https://<user>.github.io via a
# built-in regex (see ENABLE_GITHUB_PAGES_CORS). Custom Pages domains must still be listed here.

# Set to 0 to disable the automatic https://*.github.io CORS rule (default: enabled).
# ENABLE_GITHUB_PAGES_CORS=1

# MCMC (optional; lower draws/tune on small Fly VMs for faster weekly refit)
# POSTERIOR_DRAWS=600
# POSTERIOR_TUNE=600
# POSTERIOR_CHAINS=2
# PRIOR_BACKFILL_DRAWS=400
# PRIOR_BACKFILL_TUNE=400
# PRIOR_BACKFILL_CHAINS=1

# First browser/dashboard hit with no snapshot: cap MCMC (full POSTERIOR_* on admin refit)
# COLD_START_POSTERIOR_DRAWS=400
# COLD_START_POSTERIOR_TUNE=400
# COLD_START_POSTERIOR_CHAINS=2

# ---------------------------------------------------------------------------
# GitHub Pages frontend build (Actions workflow deploy-github-pages.yml)
# ---------------------------------------------------------------------------
# VITE_API_URL — same as public API base, e.g. https://my-app.fly.dev (no trailing slash).
# Put this in repo-root .env.production.local for local `npm run build` — Vite loads .env from
# the repo root (not only frontend/). ADMIN_API_KEY alone does not set the browser API URL.
# Fly CORS: include https://<your-github-username>.github.io, or rely on default github.io regex.

# ---------------------------------------------------------------------------
# GitHub Actions (repo Settings → Secrets → Actions), or run:
#   ./scripts/set_github_actions_secrets.sh https://your-api.example.com
# ---------------------------------------------------------------------------
# API_BASE_URL   = https://your-api.example.com   (no trailing slash)
# ADMIN_API_KEY  = same as ADMIN_API_KEY on the API host

# ---------------------------------------------------------------------------
# Weekly Statcast SPA — local Parquet extracts (optional; avoids live Savant pulls)
# ---------------------------------------------------------------------------
# Default directory: <repo>/data/statcast_local/{season}_{TEAM}.parquet
# Build: python scripts/download_statcast_extracts.py --seasons 2025 --all-teams
# STATCAST_LOCAL_DIR=/absolute/path/to/statcast_local

# ---------------------------------------------------------------------------
# Legacy Statcast stack (etl/, api/, web/) — see requirements-statcast.txt
# ---------------------------------------------------------------------------
# DB_URL=postgresql://user:password@localhost:5432/bluejays
# STATCAST_START=2023-01-01
# STATCAST_END=2023-12-31
