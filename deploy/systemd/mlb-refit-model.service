[Unit]
Description=MLB Forecast — weekly Bayesian refit (admin API)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/mlb
Environment=API_BASE_URL=http://127.0.0.1:8000
# Environment=ADMIN_API_KEY=...
ExecStart=/opt/mlb/scripts/call_admin.sh refit

[Install]
WantedBy=multi-user.target
